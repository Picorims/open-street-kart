vars {
    personStyle: {
        stroke: "#222222"
        fill: "#c9c9c9"
    }
    description: "Assuming the server and host client run on the same machine (this does not cover a dedicated server architecture)"
}

**: {
    &shape: person
    style: {
        stroke: "#222222"
        fill: "#c9c9c9"
    }
}

shape: sequence_diagram

host: {
    shape: person
}
server {
    style: {
        stroke: "#ac6803"
        fill: "#fae2bd"
    }
}
host client: {
    style: {
        stroke: "#c80dee"
        fill: "#f7dafd"
    }
}
guest clients: {
    style: {
        multiple: true
    }
}
guests: {
    shape: person
    style: {
        multiple: true
    }
}

[layer_names]

3d_physics/layer_1="General collision layer  (Layer 1)"
3d_physics/layer_2="Cast To Ground (Layer 2)"
3d_physics/layer_3="Car on track layer (Layer 3)"
3d_physics/layer_4="Car out of track layer (Layer 4)"
3d_physics/layer_5="Car on ground layer (Layer 5)"
3d_physics/layer_6="Managed freeze layer (Layer 6)"
3d_physics/layer_9="Rideable by wheels (Layer 9)"
3d_physics/layer_17="Out of bounds (Layer 17)"
3d_physics/layer_18="In the race (Layer 18)"
3d_physics/layer_19="Car passes checkpoint (Layer 19)"

[physics]

common/physics_ticks_per_second=240
common/physics_jitter_fix=0.0
3d/physics_engine="GodotPhysics3D"
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
occlusion_culling/use_occlusion_culling=true

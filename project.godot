; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Open Street Kart"
config/version="1.0.0-alpha.7"
config/tags=PackedStringArray("3d", "physics", "vehicle")
run/main_scene="uid://cqejs1vq3nqq1"
config/features=PackedStringArray("4.4", "Mobile")
run/max_fps=60
config/icon="res://icon.svg"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[editor_plugins]

enabled=PackedStringArray("res://addons/sky_3d/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[gui]

theme/custom="uid://mcxm36operox"

